{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Jalsa Restaurant — Hosur",
    "version": "1.0.0",
    "description": "SINGLE SOURCE OF TRUTH for every colour in the application. Values are taken from the approved design set in 'Design planning documentation/' — the guest, staff and owner artboards (warm ground #EDE7E4, maroon #7A1C24, ink #241F1E) and the kitchen/KDS artboard, which is the design's own dark surface and is therefore the dark theme rather than an invented one. Nothing else in the codebase may contain a colour literal.",
    "howToRebrand": [
      "1. Edit brand.* below (usually only 2-4 values).",
      "2. Re-point any semantic tokens that should follow the new brand.",
      "3. Run: npm run theme:build   (regenerates CSS variables + typed TS tokens)",
      "4. Run: npm run theme:contrast (fails the build if any pair breaks WCAG)",
      "5. Run: npm run theme:assets  (verifies a logo variant exists for each theme)"
    ],
    "layoutNote": "bottomChromeClearance is the ONLY number a screen may use to clear a fixed bottom bar. The guest cart bar and the staff tab bar are both 58px; clearance adds the safe-area breathing room.",
    "notes": "layout.note was moved to meta because scripts/theme-build.mjs emits EVERY string in the layout block as a CSS custom property, and a prose sentence containing a semicolon or a colon becomes an invalid declaration that fails the stylesheet build. Recorded as a framework promotion candidate rather than fixed per-app: the process files are linked, not copied."
  },
  "brand": {
    "primary": {
      "light": "#7A1C24",
      "dark": "#FFD9A0",
      "note": "Jalsa maroon. On the dark (kitchen) surface the design's own accent is the warm gold, so that is the dark-theme identity fill."
    },
    "secondary": {
      "light": "#4F6136",
      "dark": "#A8C98F",
      "note": "Sage second voice — confirmed, served, ready."
    },
    "accent": {
      "light": "#8A5A10",
      "dark": "#FFD9A0",
      "note": "Warm amber. Attention without alarm: cooking, holds, in-progress."
    }
  },
  "radius": {
    "none": "0px",
    "sm": "10px",
    "md": "16px",
    "lg": "20px",
    "xl": "26px",
    "pill": "9999px"
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "22px",
    "6": "30px",
    "7": "44px",
    "8": "64px"
  },
  "typography": {
    "fontFamilyBase": "var(--font-body), 'Noto Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "size": {
      "caption": "11.5px",
      "body": "13px",
      "bodyLg": "15px",
      "h3": "17px",
      "h2": "21px",
      "h1": "26px",
      "hero": "34px"
    },
    "lineHeight": {
      "caption": "16px",
      "body": "19px",
      "bodyLg": "22px",
      "h3": "23px",
      "h2": "27px",
      "h1": "32px",
      "hero": "40px"
    },
    "weight": {
      "body": "400",
      "medium": "500",
      "subheading": "600",
      "heading": "700"
    }
  },
  "motion": {
    "duration": {
      "instant": "90ms",
      "fast": "160ms",
      "base": "260ms",
      "slow": "420ms"
    },
    "easing": {
      "out": "cubic-bezier(0.16,1,0.3,1)",
      "inOut": "cubic-bezier(0.65,0,0.35,1)",
      "in": "cubic-bezier(0.55,0,1,0.45)"
    },
    "note": "Every animation must collapse to its END STATE under prefers-reduced-motion. Motion never gates interactivity."
  },
  "elevation": {
    "flat": {
      "light": "none",
      "dark": "none"
    },
    "card": {
      "light": "0 1px 2px rgba(36,31,30,0.05), 0 8px 22px rgba(36,31,30,0.05)",
      "dark": "0 1px 2px rgba(0,0,0,0.6), 0 8px 22px rgba(0,0,0,0.45)"
    },
    "raised": {
      "light": "0 2px 6px rgba(36,31,30,0.08), 0 24px 56px rgba(36,31,30,0.16)",
      "dark": "0 2px 6px rgba(0,0,0,0.7), 0 24px 56px rgba(0,0,0,0.55)"
    }
  },
  "layout": {
    "minSupportedWidth": "320px",
    "contentMaxWidth": "1240px",
    "guestMaxWidth": "430px",
    "minTouchTarget": "44px",
    "bottomChromeHeight": "58px",
    "bottomChromeClearance": "74px",
    "guestHeaderHeight": "68px"
  },
