{
  "name": "jalsa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "playwright test tests/unit --reporter=list",
    "test:functional": "playwright test tests/functional --reporter=list,html",
    "test:render": "playwright test tests/render --reporter=list",
    "test:all": "playwright test --reporter=list,html",
    "theme:build": "node ../scripts/theme-build.mjs --tokens design/tokens.json --out src/theme",
    "theme:contrast": "node ../scripts/check-contrast.mjs --tokens design/tokens.json --baseline .baselines/contrast-baseline.txt",
    "gate": "node ../scripts/gate-runner.mjs --cwd .",
    "framework:status": "node ../scripts/lineage.mjs --status",
    "framework:upgrade": "node ../scripts/upgrade.mjs",
    "icons:build": "node scripts/gen-pwa-icons.mjs",
    "theme:assets": "node ../scripts/check-theme-assets.mjs",
    "audit:colors": "node ../scripts/audits/check-hardcoded-colors.mjs",
    "audit:testids": "node ../scripts/audits/check-testid-coverage.mjs",
    "audit:columns": "node ../scripts/audits/check-column-control.mjs",
    "audit:fixtures": "node ../scripts/audits/check-fixture-leak.mjs",
    "audit:deadweight": "node ../scripts/audits/check-dead-weight.mjs",
    "audit:pwa": "node ../scripts/audits/check-pwa-baseline.mjs",
    "audit:typography": "node scripts/check-typography.mjs",
    "audit:all": "node ../scripts/par.mjs \"theme-sync=npm run --silent theme:check\" \"contrast=npm run --silent theme:contrast\" \"theme-assets=npm run --silent theme:assets\" \"colors=npm run --silent audit:colors\" \"testids=npm run --silent audit:testids\" \"columns=npm run --silent audit:columns\" \"fixtures=npm run --silent audit:fixtures\" \"deadweight=npm run --silent audit:deadweight\" \"pwa=npm run --silent audit:pwa\" \"typography=npm run --silent audit:typography\"",
    "theme:check": "node ../scripts/theme-build.mjs --tokens design/tokens.json --out src/theme --check",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test:reset": "node scripts/reset-test-db.mjs",
    "bridge:build": "esbuild bridge/src/main.ts --bundle --outfile=bridge/dist/main.js --platform=node --format=esm --target=node20 --log-level=warning",
    "bridge:package": "esbuild bridge/package/build.ts --bundle --packages=external --outfile=bridge/dist/package-builder.mjs --platform=node --format=esm --target=node20 --log-level=warning && node bridge/dist/package-builder.mjs"
  },
  "//": "Dependencies ARE pinned here, deliberately: the starter is a shape, but a restaurant that cannot reproduce tonight's build tomorrow morning has no build. Every version below was installed and verified at scaffold time and the lockfile is committed.",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
