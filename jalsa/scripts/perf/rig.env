# perf rig — the environment the app is BUILT and RUN with against the local rig. No credential here:
# every key is a placeholder the rig's gateway accepts and nothing else does.
export APP_ENV=test NODE_ENV=production PUBLIC_APP_URL=http://localhost:3400 PUBLIC_API_URL=http://localhost:3400/api
export NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_perf_rig
export SUPABASE_SECRET_KEY=sb_secret_perf_rig_not_a_credential SESSION_SECRET=perf-rig-session-secret-not-a-credential ALLOW_OUTBOUND_MESSAGES=false
