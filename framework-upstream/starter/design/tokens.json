  "assets": {
    "_doc": "Every brand mark, icon set and text-bearing image declares a variant per theme. The build fails if a declared variant file is missing. A single logo is legal ONLY when it is contrast-safe on both background AND surface in both themes - and that must be asserted, not assumed.",
    "strategy": "per-theme",
    "items": [
      {
        "id": "logo.primary",
        "description": "Full wordmark used in the app header",
        "light": "/brand/logo-light.svg",
        "dark": "/brand/logo-dark.svg",
        "minContrastAgainst": [
          "background",
          "surface"
        ],
        "note": "The 'light' file is the artwork drawn FOR the light theme (dark ink). The 'dark' file is drawn FOR the dark theme (light ink)."
      },
      {
        "id": "logo.mark",
        "description": "Square app mark / favicon source",
        "light": "/brand/mark-light.svg",
        "dark": "/brand/mark-dark.svg",
        "minContrastAgainst": [
          "background"
        ]
      },
      {
        "id": "illustration.empty",
        "description": "Empty-state illustration",
        "light": "/brand/empty-light.svg",
        "dark": "/brand/empty-dark.svg",
        "minContrastAgainst": [
          "surface"
        ]
      },
      {
        "id": "og.social",
        "description": "Open Graph / social preview card. Fixed to the light artwork on purpose: social platforms render it on their own canvas, so it must not follow the viewer theme.",
        "light": "/brand/og-card.png",
        "dark": "/brand/og-card.png",
        "themeIndependent": true,
        "note": "Social platforms render this on their own canvas, which we do not control and cannot query for a theme. A viewer-theme-dependent card would be wrong roughly half the time, so it is deliberately fixed to the light artwork and its own contrast is self-contained."
      }
    ]
  }
}
