{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Default Framework Palette",
    "version": "1.0.0",
    "description": "SINGLE SOURCE OF TRUTH for every colour in the application. Nothing else in the codebase may contain a colour literal. Change values here and the whole application changes, in both themes, consistently.",
    "howToRebrand": [
      "1. Edit brand.* below (usually only 2-4 values).",
      "2. Re-point any semantic tokens that should follow the new brand.",
      "3. Run: npm run theme:build   (regenerates CSS variables + typed TS tokens)",
      "4. Run: npm run theme:contrast (fails the build if any pair breaks WCAG)",
      "5. Run: npm run theme:assets  (verifies a logo variant exists for each theme)"
    ]
  },
  "app": {
    "_doc": "Application IDENTITY and installability. The web app manifest is generated from this block plus the semantic colours below - it is never hand-written, for the same reason no generated theme file is: theme_color and background_color are COLOUR DECISIONS, and colour lives in exactly one file. Rebrand here, run `npm run theme:build`, and the installed app follows. A hand-edited manifest.webmanifest is caught by gate G1 exactly like a hand-edited stylesheet.",
    "name": "Default Framework App",
    "shortName": "Framework",
    "description": "An application built with the custom web app development framework.",
    "id": "/",
    "startUrl": "/",
    "scope": "/",
    "display": "standalone",
    "displayOverride": [
      "window-controls-overlay",
      "standalone",
      "minimal-ui"
    ],
    "orientation": "any",
    "lang": "en",
    "dir": "ltr",
    "categories": [
      "productivity"
    ],
    "themeColorToken": "background",
    "backgroundColorToken": "background",
    "_colorDoc": "Which SEMANTIC token the OS chrome and the splash canvas take. Named as tokens, not values, so a rebrand cannot leave the installed window a different colour from the app inside it. The manifest carries the LIGHT value because a manifest has one; the document additionally ships a per-scheme meta theme-color, and ThemeProvider keeps it in step at runtime.",
    "icons": [
      {
        "src": "/brand/mark-light.svg",
        "sizes": "any",
        "type": "image/svg+xml",
        "purpose": "any",
        "note": "Scalable mark. Chromium installs from this; see KNOWN_LIMITATIONS for iOS, which needs a raster icon."
      },
      {
        "src": "/brand/maskable-192.png",
        "sizes": "192x192",
        "type": "image/png",
        "purpose": "maskable",
        "note": "Maskable raster icon. Required for a correct Android launcher shape and the iOS home screen.",
        "generated": true
      },
      {
        "src": "/brand/maskable-512.png",
        "sizes": "512x512",
        "type": "image/png",
        "purpose": "maskable",
        "note": "Large raster icon: the install dialog and the splash screen use this one.",
        "generated": true
      }
    ],
    "offlineFallback": "/offline.html",
    "serviceWorker": "/sw.js",
    "iconFieldToken": "primary",
    "iconMarkToken": "onPrimary",
    "_iconDoc": "The PNG icons are GENERATED from iconFieldToken/iconMarkToken - a flat field with a centred disc, full-bleed because a maskable icon is cropped to a shape the platform chooses. They exist so a scaffolded app is installable on day one with no manual step. Replace them with real artwork and drop `generated: true`: the theme build then leaves them alone forever. An icon the app owns is never overwritten and never reported as drift."
  },
  "brand": {
    "primary": {
      "light": "#4F46E5",
      "dark": "#818CF8",
      "note": "Identity colour. Large fills, primary CTA."
    },
    "secondary": {
      "light": "#0F766E",
      "dark": "#5EEAD4",
      "note": "Supporting identity colour."
    },
    "accent": {
      "light": "#B45309",
      "dark": "#F59E0B",
      "note": "Attention / highlight. Interactive text on dark surfaces."
    }
  },
  "radius": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "pill": "9999px"
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "typography": {
    "fontFamilyBase": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "size": {
      "caption": "12px",
      "body": "14px",
      "bodyLg": "16px",
      "h3": "20px",
      "h2": "24px",
      "h1": "30px",
      "hero": "38px"
    },
    "lineHeight": {
      "caption": "16px",
      "body": "20px",
      "bodyLg": "24px",
      "h3": "28px",
      "h2": "32px",
      "h1": "38px",
      "hero": "46px"
    },
    "weight": {
      "body": "400",
      "medium": "500",
      "subheading": "600",
      "heading": "700"
    }
  },
  "motion": {
    "duration": {
      "instant": "90ms",
      "fast": "160ms",
      "base": "260ms",
      "slow": "420ms"
    },
    "easing": {
      "out": "cubic-bezier(0.16,1,0.3,1)",
      "inOut": "cubic-bezier(0.65,0,0.35,1)",
      "in": "cubic-bezier(0.55,0,1,0.45)"
    },
    "note": "Every animation must collapse to its END STATE under prefers-reduced-motion. Motion never gates interactivity."
  },
  "elevation": {
    "flat": {
      "light": "none",
      "dark": "none"
    },
    "card": {
      "light": "0 1px 2px rgba(16,24,40,0.06), 0 1px 3px rgba(16,24,40,0.10)",
      "dark": "0 1px 2px rgba(0,0,0,0.60), 0 1px 3px rgba(0,0,0,0.45)"
    },
    "raised": {
      "light": "0 4px 8px rgba(16,24,40,0.08), 0 12px 24px rgba(16,24,40,0.10)",
      "dark": "0 4px 8px rgba(0,0,0,0.65), 0 12px 24px rgba(0,0,0,0.50)"
    }
  },
  "layout": {
    "minSupportedWidth": "320px",
    "contentMaxWidth": "1200px",
    "minTouchTarget": "44px",
    "bottomChromeHeight": "0px",
    "bottomChromeClearance": "0px",
    "note": "bottomChromeClearance is the ONLY number a screen may use to clear a fixed bottom bar. Never hand-pick padding."
  },
  "semantic": {
    "_doc": "Semantic tokens are the ONLY colours application code may reference. Each has a light and a dark value. Names describe ROLE, never appearance: use `text.muted`, never `grey600`.",
    "background": {
      "light": "#FFFFFF",
      "dark": "#0D1117",
      "role": "Page canvas"
    },
    "surface": {
      "light": "#F7F8FA",
      "dark": "#161B22",
      "role": "Cards, panels, sheets"
    },
    "surfaceRaised": {
      "light": "#FFFFFF",
      "dark": "#1C232C",
      "role": "Modals, popovers, menus"
    },
    "surfaceSunken": {
      "light": "#EEF0F4",
      "dark": "#0A0E14",
      "role": "Wells, inset areas, code blocks"
    },
    "text.heading": {
      "light": "#0B0F19",
      "dark": "#FFFFFF",
      "role": "Headings, titles"
    },
    "text.body": {
      "light": "#1F2430",
      "dark": "#E6EAF2",
      "role": "Default body copy"
    },
    "text.muted": {
      "light": "#5A6478",
      "dark": "#9BA6B8",
      "role": "Secondary / helper text"
    },
    "text.inverse": {
      "light": "#FFFFFF",
      "dark": "#0D1117",
      "role": "Text on a filled brand surface"
    },
    "text.disabled": {
      "light": "#8A93A5",
      "dark": "#6C7686",
      "role": "Disabled label (WCAG-exempt, still kept >=3:1)"
    },
    "text.link": {
      "light": "#4F46E5",
      "dark": "#A5B4FC",
      "role": "Inline hyperlink"
    },
    "text.linkHover": {
      "light": "#3730A3",
      "dark": "#C7D2FE",
      "role": "Hyperlink hover/active"
    },
    "primary": {
      "light": "#4F46E5",
      "dark": "#818CF8",
      "role": "Primary CTA fill"
    },
    "primaryHover": {
      "light": "#4338CA",
      "dark": "#A5B4FC",
      "role": "Primary CTA hover"
    },
    "primaryPressed": {
      "light": "#3730A3",
      "dark": "#C7D2FE",
      "role": "Primary CTA pressed"
    },
    "onPrimary": {
      "light": "#FFFFFF",
      "dark": "#0D1117",
      "role": "Content on primary fill"
    },
    "primarySurface": {
      "light": "#EEF2FF",
      "dark": "#1E1B4B",
      "role": "Tinted primary background"
    },
    "onPrimarySurface": {
      "light": "#312E81",
      "dark": "#C7D2FE",
      "role": "Content on primarySurface"
    },
    "secondary": {
      "light": "#0F766E",
      "dark": "#5EEAD4",
      "role": "Secondary action fill"
    },
    "onSecondary": {
      "light": "#FFFFFF",
      "dark": "#0D1117",
      "role": "Content on secondary fill"
    },
    "accent": {
      "light": "#B45309",
      "dark": "#F59E0B",
      "role": "Highlight / interactive accent text"
    },
    "onAccent": {
      "light": "#FFFFFF",
      "dark": "#0D1117",
      "role": "Content on accent fill"
    },
    "border": {
      "light": "#D6DAE3",
      "dark": "#2A313C",
      "role": "Decorative separators (NOT contrast-gated)"
    },
    "borderStrong": {
      "light": "#6B7488",
      "dark": "#8A94A6",
      "role": "Meaningful boundaries: inputs, checkboxes, dividers that carry meaning"
    },
    "borderFocus": {
      "light": "#4F46E5",
      "dark": "#818CF8",
      "role": "Focus ring — MUST be >=3:1 against every adjacent surface"
    },
    "error": {
      "light": "#B91C1C",
      "dark": "#F87171",
      "role": "Destructive / failure"
    },
    "onError": {
      "light": "#FFFFFF",
      "dark": "#0D1117",
      "role": "Content on error fill"
    },
    "errorSurface": {
      "light": "#FEF2F2",
      "dark": "#2A1416",
      "role": "Error banner background"
    },
    "onErrorSurface": {
      "light": "#991B1B",
      "dark": "#FCA5A5",
      "role": "Content on errorSurface"
    },
    "success": {
      "light": "#15803D",
      "dark": "#4ADE80",
      "role": "Success / confirmed"
    },
    "onSuccess": {
      "light": "#FFFFFF",
      "dark": "#0D1117",
      "role": "Content on success fill"
    },
    "successSurface": {
