      "dark": "#0F2417",
      "role": "Success banner background"
    },
    "onSuccessSurface": {
      "light": "#166534",
      "dark": "#86EFAC",
      "role": "Content on successSurface"
    },
    "warning": {
      "light": "#92400E",
      "dark": "#FBBF24",
      "role": "Warning / needs attention"
    },
    "onWarning": {
      "light": "#FFFFFF",
      "dark": "#0D1117",
      "role": "Content on warning fill"
    },
    "warningSurface": {
      "light": "#FFFBEB",
      "dark": "#2A1F06",
      "role": "Warning banner background"
    },
    "onWarningSurface": {
      "light": "#854D0E",
      "dark": "#FDE68A",
      "role": "Content on warningSurface"
    },
    "info": {
      "light": "#1D4ED8",
      "dark": "#60A5FA",
      "role": "Informational"
    },
    "onInfo": {
      "light": "#FFFFFF",
      "dark": "#0D1117",
      "role": "Content on info fill"
    },
    "infoSurface": {
      "light": "#EFF6FF",
      "dark": "#0C1E36",
      "role": "Info banner background"
    },
    "onInfoSurface": {
      "light": "#1E40AF",
      "dark": "#BFDBFE",
      "role": "Content on infoSurface"
    },
    "overlay": {
      "light": "rgba(11,15,25,0.45)",
      "dark": "rgba(0,0,0,0.65)",
      "role": "Modal scrim"
    },
    "skeleton": {
      "light": "#E7EAF0",
      "dark": "#232B36",
      "role": "Loading placeholder block"
    }
  },
  "contrastPolicy": {
