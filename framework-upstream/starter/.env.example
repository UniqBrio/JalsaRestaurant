# ---------------------------------------------------------------------------
# ENVIRONMENT TEMPLATE - copy to .env and fill in. NEVER commit .env.
#
# THE PREFIX IS THE TRUST BOUNDARY
#   PUBLIC_*   is bundled into the client. Treat every value as world-readable, permanently.
#   No prefix  is server-only and must never be imported from client code.
#
#   Making the boundary visible in the NAME means a reviewer can spot a leaked secret without
#   tracing an import graph. That is worth the noisy prefix.
#
# WHAT BELONGS HERE
#   Every variable the application requires, with a comment on what it is for. A variable that
#   exists only in someone's shell is a variable that will be missing in production.
#   Real values never belong here - not even "harmless" ones.
# ---------------------------------------------------------------------------

# --- Environment identity --------------------------------------------------
# development | test | staging | production
# Deliberately independent of NODE_ENV: a staging deploy is a PRODUCTION BUILD pointed at
# NON-PRODUCTION DATA. Conflating the two is how a test run reaches live customers.
APP_ENV=development

# --- Public (client-visible) -----------------------------------------------
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api
# Injected by CI from the commit SHA. Leave EMPTY locally: the client compares it against the
# server's /api/version to detect a stale bundle, and a hand-set value defeats that.
PUBLIC_BUILD_ID=

# --- Server-only secrets ---------------------------------------------------
DATABASE_URL=
SESSION_SECRET=

# --- Outbound safety -------------------------------------------------------
# OFF by default, on purpose. The worst case of a wrong default here is a real message to a
# real customer from a test run; the worst case of this default is a test that does not send.
ALLOW_OUTBOUND_MESSAGES=false
# Comma-separated. When outbound is enabled in a non-production environment, ONLY these
# destinations may receive anything. Anything else must stop and ask.
OUTBOUND_ALLOWLIST=

# --- Test environment (.env.test) ------------------------------------------
# TEST_APP_URL=http://localhost:3000
# TEST_DATABASE_URL=
# Never point a test run at production. Name the environments explicitly in
# docs/registers/ENVIRONMENTS.md so "which database was that?" is never a guess.
