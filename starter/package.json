{
  "name": "app-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",

    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",

    "test:unit": "playwright test tests/unit --reporter=list",
    "test:functional": "playwright test tests/functional --reporter=list,html",
    "test:render": "playwright test tests/render --reporter=list",
    "test:all": "playwright test --reporter=list,html",

    "theme:build": "node ../scripts/theme-build.mjs --tokens design/tokens.json --out src/theme",
    "theme:contrast": "node ../scripts/check-contrast.mjs --tokens design/tokens.json --baseline .baselines/contrast-baseline.txt",

    "gate": "node ../scripts/gate-runner.mjs --cwd ."
  },
  "//": "Dependencies are intentionally NOT pinned here. This starter is a SHAPE, not a lockfile. Install the versions current when you scaffold, verify each package exists and is the intended name before installing, and commit the lockfile."
}
